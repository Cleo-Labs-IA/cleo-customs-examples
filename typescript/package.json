{
  "name": "cleo-customs-examples-typescript",
  "private": true,
  "type": "module",
  "description": "TypeScript examples for the Cleo Customs Classification API, using @cleo-legal/sdk.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "needs-information": "tsx src/needs-information.ts",
    "full-decision": "tsx src/full-decision.ts",
    "batch": "tsx src/batch.ts",
    "human-review": "tsx src/human-review.ts",
    "webhook-verify": "tsx src/webhook-verify.ts",
    "typecheck": "tsc --noEmit",
    "use-local-sdk": "sh ../scripts/use-local-sdk.sh"
  },
  "dependencies": {
    "@cleo-legal/sdk": "0.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
